generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Périmètre d'une permission : enregistrements propres, de l'équipe, ou tous.
enum PermissionScope {
  OWN
  TEAM
  ALL
}

model Team {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @unique
  managerId String?   @map("manager_id") @db.Uuid
  manager   User?     @relation("TeamManager", fields: [managerId], references: [id])
  members   User[]    @relation("TeamMembers")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("team")
}

model User {
  id                   String        @id @default(uuid(7)) @db.Uuid
  /// Normalisé en minuscules par l'application avant écriture.
  email                String        @unique
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  /// Argon2id ; null tant que le compte n'a pas défini son mot de passe.
  passwordHash         String?       @map("password_hash")
  isActive             Boolean       @default(true) @map("is_active")
  failedLoginCount     Int           @default(0) @map("failed_login_count")
  lockedUntil          DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(3)
  teamId               String?       @map("team_id") @db.Uuid
  team                 Team?         @relation("TeamMembers", fields: [teamId], references: [id])
  managerId            String?       @map("manager_id") @db.Uuid
  manager              User?         @relation("UserManager", fields: [managerId], references: [id])
  directReports        User[]        @relation("UserManager")
  managedTeams         Team[]        @relation("TeamManager")
  roles                UserRole[]
  auditLogs            AuditLog[]
  sessions             Session[]
  assignedLeads        Lead[]        @relation("AssignedLeads")
  authoredInteractions Interaction[] @relation("AuthoredInteractions")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(3)

  // Lot 2 : opportunités commerciales
  ownedOpportunities   Opportunity[] @relation("OpportunityOwner")
  createdOpportunities Opportunity[] @relation("OpportunityCreator")

  // Lot 2 : devis
  createdQuotes Quote[] @relation("QuoteCreator")

  // Lot 2 : approbations des devis
  requestedQuoteApprovals QuoteApproval[] @relation("QuoteApprovalRequester")
  reviewedQuoteApprovals  QuoteApproval[] @relation("QuoteApprovalReviewer")

  // Lot 2 : tâches
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  // Lot 2 : agenda
  ownedCalendarEvents   CalendarEvent[] @relation("CalendarEventOwner")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")

  @@index([teamId])
  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Code stable utilisé dans le code (ex. SALES_REP) ; libellé modifiable.
  code        String           @unique
  name        String
  description String?
  /// Rôle livré par le système, non supprimable depuis l'interface.
  isSystem    Boolean          @default(false) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("role")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Ressource métier (ex. lead, opportunity, ticket).
  resource    String
  /// Action (ex. read, create, update, delete, approve, export).
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// Session de connexion côté serveur, référencée par un cookie HttpOnly.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256 (hex) du jeton de session ; le jeton brut n'est jamais stocké.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Dernière activité, pour l'expiration après inactivité.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Expiration absolue, quelle que soit l'activité.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("user_session")
}

/// Journal d'audit en ajout seul : UPDATE et DELETE sont refusés par un trigger.
/// Ne jamais y stocker de mot de passe, jeton ou secret.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
}

/// Statut d'un prospect (Lead).
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

/// Canal d'interaction avec un contact ou prospect.
enum InteractionChannel {
  CALL
  EMAIL
  MEETING
  NOTE
  WHATSAPP
}

/// Sens de l'interaction.
enum InteractionDirection {
  INBOUND
  OUTBOUND
}

/// Statut d'un produit ou service au catalogue.
enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Étapes du pipeline commercial : qualification, proposition, négociation, affaire gagnée ou perdue.
enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// Statut du devis tout au long de son cycle de vie, de la création à la clôture.
enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Résultat ou état d'une demande d'approbation d'un devis.
enum QuoteApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// État d'avancement d'une tâche dans le CRM.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Niveau de priorité d'une tâche pour organiser le travail.
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Type d'événement pouvant être enregistré dans l'agenda.
enum CalendarEventType {
  MEETING
  CALL
  REMINDER
  OTHER
}

/// État d'un événement de l'agenda : planifié, terminé ou annulé.
enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Organisation (entreprise, institution, prospect ou client).
model Organization {
  id                 String          @id @default(uuid(7)) @db.Uuid
  name               String
  industry           String?
  address            String?
  phone              String?
  email              String?
  isClient           Boolean         @default(false) @map("is_client")
  becameCustomerDate DateTime?       @map("became_customer_date") @db.Timestamptz(3)
  status             String          @default("PROSPECT")
  contacts           Contact[]
  leads              Lead[]
  interactions       Interaction[]
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)
  opportunities      Opportunity[]
  quotes             Quote[]
  tasks              Task[]
  calendarEvents     CalendarEvent[]

  @@index([name])
  @@index([isClient])
  @@map("organization")
}

/// Contact individuel rattaché à une organisation.
model Contact {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?         @map("job_title")
  preferences    String?
  leads          Lead[]
  interactions   Interaction[]
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)
  opportunities  Opportunity[]
  quotes         Quote[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([email])
  @@index([phone])
  @@index([organizationId])
  @@map("contact")
}

/// Prospect commercial (Lead).
model Lead {
  id             String        @id @default(uuid(7)) @db.Uuid
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  companyName    String?       @map("company_name")
  email          String?
  phone          String?
  source         String        @default("AUTRE")
  status         LeadStatus    @default(NEW)
  score          Int           @default(0)
  assignedUserId String?       @map("assigned_user_id") @db.Uuid
  assignedUser   User?         @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  convertedAt    DateTime?     @map("converted_at") @db.Timestamptz(3)
  interactions   Interaction[]
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)
  opportunities  Opportunity[]

  @@index([email])
  @@index([phone])
  @@index([companyName])
  @@index([status])
  @@index([assignedUserId])
  @@map("lead")
}

/// Historique des interactions (appels, emails, réunions, notes, whatsapp).
model Interaction {
  id             String               @id @default(uuid(7)) @db.Uuid
  channel        InteractionChannel
  direction      InteractionDirection @default(OUTBOUND)
  occurredAt     DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  summary        String
  userId         String?              @map("user_id") @db.Uuid
  user           User?                @relation("AuthoredInteractions", fields: [userId], references: [id], onDelete: SetNull)
  leadId         String?              @map("lead_id") @db.Uuid
  lead           Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?              @map("contact_id") @db.Uuid
  contact        Contact?             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String?              @map("organization_id") @db.Uuid
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([leadId])
  @@index([contactId])
  @@index([organizationId])
  @@index([occurredAt])
  @@map("interaction")
}

/// Article du catalogue de produits et services.
model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  sku         String        @unique
  name        String
  description String?
  unitPrice   Decimal       @map("unit_price") @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  quoteItems  QuoteItem[]

  @@index([sku])
  @@index([status])
  @@map("product")
}

model Opportunity {
  id          String           @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  stage       OpportunityStage @default(QUALIFICATION)

  amount      Decimal @default(0) @db.Decimal(12, 2)
  probability Int     @default(0) @db.SmallInt

  expectedCloseDate DateTime? @map("expected_close_date") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  lostReason        String?   @map("lost_reason")

  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  ownerUserId String @map("owner_user_id") @db.Uuid
  owner       User   @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("OpportunityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  quotes         Quote[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([stage])
  @@index([ownerUserId, stage])
  @@index([organizationId])
  @@index([leadId])
  @@index([expectedCloseDate])
  @@map("opportunity")
}

model Quote {
  id      String      @id @default(uuid(7)) @db.Uuid
  number  String      @unique
  version Int         @default(1)
  status  QuoteStatus @default(DRAFT)

  issueDate  DateTime  @default(now()) @map("issue_date") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)

  currency       String  @default("XOF") @db.VarChar(3)
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  notes String?
  terms String?

  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  items     QuoteItem[]
  approvals QuoteApproval[]
  tasks     Task[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([createdByUserId])
  @@map("quote")
}

model QuoteItem {
  id      String @id @default(uuid(7)) @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productSku         String? @map("product_sku")
  productName        String  @map("product_name")
  description        String?
  quantity           Decimal @db.Decimal(12, 3)
  unitPrice          Decimal @map("unit_price") @db.Decimal(12, 2)
  discountRate       Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate            Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal       Decimal @map("line_subtotal") @db.Decimal(12, 2)
  lineDiscountAmount Decimal @default(0) @map("line_discount_amount") @db.Decimal(12, 2)
  lineTaxAmount      Decimal @default(0) @map("line_tax_amount") @db.Decimal(12, 2)
  lineTotal          Decimal @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_item")
}

model QuoteApproval {
  id      String @id @default(uuid(7)) @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  status QuoteApprovalStatus @default(PENDING)

  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  requestedBy       User   @relation("QuoteApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  approverUserId String @map("approver_user_id") @db.Uuid
  approver       User   @relation("QuoteApprovalReviewer", fields: [approverUserId], references: [id], onDelete: Restrict)

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(3)
  comments    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([quoteId, requestedAt])
  @@index([approverUserId, status])
  @@index([requestedByUserId])
  @@map("quote_approval")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)

  dueAt       DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  assignedUserId String? @map("assigned_user_id") @db.Uuid
  assignedUser   User?   @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  quoteId String? @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([assignedUserId, status])
  @@index([dueAt, status])
  @@index([opportunityId])
  @@index([organizationId])
  @@index([contactId])
  @@index([quoteId])
  @@map("task")
}

model CalendarEvent {
  id          String              @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)
  allDay  Boolean  @default(false) @map("all_day")

  ownerUserId String @map("owner_user_id") @db.Uuid
  owner       User   @relation("CalendarEventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdBy       User   @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([ownerUserId, startAt])
  @@index([startAt, endAt])
  @@index([opportunityId])
  @@index([organizationId])
  @@index([contactId])
  @@map("calendar_event")
}
