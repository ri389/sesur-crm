# Copier vers .env et adapter. Ne jamais committer .env.
POSTGRES_USER=sesur
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sesur_crm
# Ports publiés sur la machine par docker compose. Si un port est déjà pris
# (ex. PostgreSQL installé sous Windows sur 5432), choisir un port libre
# (ex. 15432) et reporter le même port dans DATABASE_URL / REDIS_URL.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://sesur:change-me@localhost:5432/sesur_crm
REDIS_URL=redis://localhost:6379
API_PORT=3000
# Suppression définitive des comptes réservée au développement.
APP_ENV=development
# Nombre de proxys de confiance placés devant l'API (0 si accès direct).
# Indiquer le nombre de proxys maîtrisés, notamment si TLS est terminé en amont.
TRUST_PROXY_HOPS=0
# Origine publique exacte de l'interface web (schéma + domaine, sans chemin).
# Remplacer par l'origine publique du CRM en production.
APP_ORIGIN=http://localhost:18765
# Authentification (valeurs par défaut à faire valider)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# true par défaut ; false uniquement pour un test en HTTP hors localhost
SESSION_COOKIE_SECURE=true
# Courriel des invitations par SMTP. MAIL_PASSWORD reste local et ne doit pas être commité.
MAIL_SCHEME=null
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@autopia.bj
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@autopia.bj
MAIL_FROM_NAME="Autopia"
# Durée de validité des invitations (minutes, de 1 à 43200).
INVITATION_TTL_MINUTES=15
# Clé de chiffrement AES-256-GCM des secrets TOTP : 32 octets en base64 ou 64 caractères hexadécimaux.
TOTP_ENCRYPTION_KEY=
# WhatsApp Cloud API (authentification par modèle OTP AUTHENTICATION approuvé par Meta).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=
# SLA SAV provisoire, calculé en heures calendaires (24 h/24, 7 j/7).
# Ajuster ces délais aux engagements réels avant la mise en production.
SLA_LOW_FIRST_RESPONSE_HOURS=24
SLA_LOW_RESOLUTION_HOURS=72
SLA_NORMAL_FIRST_RESPONSE_HOURS=8
SLA_NORMAL_RESOLUTION_HOURS=48
SLA_HIGH_FIRST_RESPONSE_HOURS=4
SLA_HIGH_RESOLUTION_HOURS=24
SLA_URGENT_FIRST_RESPONSE_HOURS=1
SLA_URGENT_RESOLUTION_HOURS=8
# Webhook sortant signé (optionnel). Les événements restent en attente sans configuration.
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_RETRY_MAX_ATTEMPTS=8
